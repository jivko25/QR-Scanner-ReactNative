  "version": "1.4.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "check:android": "npx expo-doctor --verbose && npx expo prebuild --no-install --platform android",
    "build:android": "eas build --platform android --profile preview && eas update --branch preview",
    "check:ios": "npx expo-doctor && npx expo prebuild --no-install --platform ios",
    "build:ios": "eas build --platform ios --profile preview"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-picker/picker": "2.11.1",
    "@react-navigation/native": "^7.1.14",
    "@react-navigation/native-stack": "^7.3.21",
    "axios": "^1.10.0",
    "babel-preset-expo": "~54.0.10",
    "expo": "^54.0.37",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.14",
    "expo-device": "~8.0.10",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-notifications": "~0.32.17",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.20",
    "lottie-react-native": "~7.3.1",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
