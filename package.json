  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "check:android": "npx expo-doctor && npx expo prebuild --no-install --platform android",
    "build:android": "eas build --platform android --profile preview && eas update --branch preview",
    "check:ios": "npx expo-doctor && npx expo prebuild --no-install --platform ios",
    "build:ios": "eas build --platform ios --profile preview"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/datetimepicker": "8.4.1",
    "@react-native-picker/picker": "2.11.1",
    "@react-navigation/native": "^7.1.14",
    "@react-navigation/native-stack": "^7.3.21",
    "axios": "^1.10.0",
    "expo": "53.0.17",
    "expo-camera": "~16.1.10",
    "expo-constants": "~17.1.7",
    "expo-device": "~7.1.4",
    "expo-image-picker": "~16.1.4",
    "expo-linear-gradient": "~14.1.5",
    "expo-notifications": "~0.31.4",
    "expo-status-bar": "~2.2.3",
    "expo-updates": "~0.28.16",
    "lottie-react-native": "7.2.2",
    "react": "19.0.0",
    "react-native": "0.79.5",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-gifted-charts": "^1.4.61",
    "react-native-modal-datetime-picker": "^18.0.0",
    "react-native-qrcode-svg": "^6.3.15",
